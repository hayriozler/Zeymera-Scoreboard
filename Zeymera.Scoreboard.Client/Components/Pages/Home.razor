@page "/"
@implements IAsyncDisposable
@inject LocalizationService L
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@inject DataContext DbContext
@inject ScoreboardCommandHub Hub
@inject IWebHostEnvironment Env
@using Zeymera.Scoreboard.Client.Models
@using Zeymera.Scoreboard.Client.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.Text.Json

<div @ref="board" class="board" tabindex="0" @onkeydown="HandleKeyDown" @onclick="RequestFullscreenAsync">

    <header class="board-header">
        <div class="header-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none">
                <path d="M26 38 L4 60" stroke="#d8d0c4" stroke-width="3" stroke-linecap="round" />
                <path d="M22 42 L31 33" stroke="#8a6a3a" stroke-width="6" stroke-linecap="round" />
                <circle cx="44" cy="16" r="8" fill="#f4c430" />
                <ellipse cx="41.3" cy="12.8" rx="2.3" ry="1.5" fill="#fff" opacity="0.55" />
                <circle cx="32" cy="32" r="8" fill="#f2f2f2" />
                <ellipse cx="29.3" cy="28.8" rx="2.3" ry="1.5" fill="#fff" opacity="0.6" />
                <circle cx="54" cy="32" r="8" fill="#c9202c" />
                <ellipse cx="51.3" cy="28.8" rx="2.3" ry="1.5" fill="#fff" opacity="0.55" />
            </svg>
        </div>

        <h1 class="title">@L.T("Title")</h1>

        <div class="header-status">
            <div class="balls" aria-hidden="true">
                <span class="ball yellow"></span>
                <span class="ball white"></span>
                <span class="ball red"></span>
            </div>
        </div>
    </header>

    <main class="scores">
        <section class="player-panel @(Current.ActivePlayer == 1 ? "active-white" : "")">
            <div class="player-name-bar">
                @if (Current.ActivePlayer == 1)
                {
                    <span class="ball white turn-ball" aria-hidden="true"></span>
                }
                @if (!string.IsNullOrEmpty(GetPhotoPath(1)))
                {
                    <img class="player-photo" src="@GetPhotoPath(1)" alt="" />
                }
                <span>@GetDisplayName(1)</span>
                @if (Current.ActivePlayer == 1)
                {
                    <span class="current-points-badge">@Current.CurrentPoints</span>
                }
            </div>
            <div class="player-score">@Current.Player1Score</div>
        </section>

        <section class="center-panel">
            <div class="center-row">
                <span class="center-label">@L.T("Inning")</span>
                <span class="center-value inning">@Current.Inning</span>
            </div>
            <div class="center-divider"></div>
            <div class="center-row">
                <span class="center-label">@L.T("ShotClock")</span>
                <span class="center-value @(Current.ShotClockActive && Current.ShotClockRemaining <= 10 ? "urgent" : "")">@ShotClockDisplaySeconds</span>
            </div>
        </section>

        <section class="player-panel @(Current.ActivePlayer == 2 ? "active-yellow" : "")">
            <div class="player-name-bar">
                @if (Current.ActivePlayer == 2)
                {
                    <span class="ball yellow turn-ball" aria-hidden="true"></span>
                }
                @if (!string.IsNullOrEmpty(GetPhotoPath(2)))
                {
                    <img class="player-photo" src="@GetPhotoPath(2)" alt="" />
                }
                <span>@GetDisplayName(2)</span>
                @if (Current.ActivePlayer == 2)
                {
                    <span class="current-points-badge">@Current.CurrentPoints</span>
                }
            </div>
            <div class="player-score yellow">@Current.Player2Score</div>
        </section>
    </main>

    <footer class="stat-bar">
        <div class="stat">
            <span class="stat-label">@L.T("Avg")</span>
            <span class="stat-value">@Current.Player1Avg.ToString("0.000")</span>
        </div>
        <div class="stat">
            <span class="stat-label">@L.T("HighRun")</span>
            <span class="stat-value">@Current.Player1HighRun</span>
        </div>
        <div class="stat">
            <span class="stat-label">@L.T("Match")</span>
            <span class="stat-value current">@Current.MatchTarget</span>
        </div>
        <div class="stat">
            <span class="stat-label">@L.T("BestAvg")</span>
            <span class="stat-value">@Current.Player2Avg.ToString("0.000")</span>
        </div>
        <div class="stat">
            <span class="stat-label">@L.T("HighRun")</span>
            <span class="stat-value">@Current.Player2HighRun</span>
        </div>
    </footer>

    <div class="shot-clock @(Current.ShotClockActive ? "active" : "") @(Current.ShotClockActive && Current.ShotClockRemaining <= 10 ? "urgent" : "")">
        <div class="shot-clock-bar" style="width:@ShotClockPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
    </div>

    <div class="sync-dot @(IsOnline ? "online" : "offline")" title="@(IsOnline ? "Control link connected" : "No control device connected")"></div>

    <div class="brand-mark" aria-hidden="true">ZEYMERA</div>

    @if (_showControls)
    {
        <div class="controls-overlay" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            <div class="control-group">
                <span>@L.T("Player1Label")</span>
                <input type="text" value="@Current.Player1Name" placeholder="@L.T("Player1Default")"
                       @onchange="e => SetPlayerName(1, e.Value?.ToString())" />
                <button @onclick="() => OpenPlayerPickerAsync(1)">@L.T("ChoosePlayer")</button>
            </div>
            <div class="control-group">
                <span>@L.T("Player2Label")</span>
                <input type="text" value="@Current.Player2Name" placeholder="@L.T("Player2Default")"
                       @onchange="e => SetPlayerName(2, e.Value?.ToString())" />
                <button @onclick="() => OpenPlayerPickerAsync(2)">@L.T("ChoosePlayer")</button>
            </div>
            <div class="control-group">
                <span>@L.T("P1Score")</span>
                <button @onclick="() => Adjust((s=> Current.Player1Score--))">-</button>
                <button @onclick="() => Adjust((s=> Current.Player1Score++))">+</button>
            </div>
            <div class="control-group">
                <span>@L.T("P2Score")</span>
                <button @onclick="() => Adjust((s=> Current.Player2Score--))">-</button>
                <button @onclick="() => Adjust((s=> Current.Player2Score++))">+</button>
            </div>
            <div class="control-group">
                <span>@L.T("Inning")</span>
                <button @onclick="() => Adjust((s=> Current.Inning--))">-</button>
                <button @onclick="() => Adjust((s=> Current.Inning++))">+</button>
            </div>
            <div class="control-group">
                <span>@L.T("Match")</span>
                <input type="number" min="1" value="@Current.MatchTarget"
                       @onchange="e => SetMatchTarget(e.Value?.ToString())" />
            </div>
            <div class="control-group">
                <span>@L.T("CurrentPoints")</span>
                <button @onclick="() => Adjust((s=> Current.CurrentPoints--))">-</button>
                <button @onclick="() => Adjust((s=> Current.CurrentPoints++))">+</button>
                <button @onclick="CommitCurrentPoints">@L.T("Add")</button>
            </div>
            <div class="control-group">
                <span>@L.T("ActivePlayer")</span>
                <button class="@(Current.ActivePlayer == 1 ? "active" : "")" @onclick="() => ChangeActivePlayer(1)">@L.T("Player1Label")</button>
                <button class="@(Current.ActivePlayer == 2 ? "active" : "")" @onclick="() => ChangeActivePlayer(2)">@L.T("Player2Label")</button>
            </div>
            <div class="control-group">
                <span>@L.T("ShotClock")</span>
                @if (Current.ShotClockActive)
                {
                    <button @onclick="StopShotClock">@L.T("Stop")</button>
                }
                else
                {
                    <button @onclick="StartShotClock">@L.T("Start")</button>
                }
                <button @onclick="ResetShotClock">@L.T("Reset")</button>
            </div>
            <div class="control-group">
                <span>Language</span>
                <select value="@L.Language" @onchange="OnLanguageChanged">
                    <option value="tr">TR</option>
                    <option value="en">EN</option>
                    <option value="nl">NL</option>
                </select>
            </div>
            <div class="control-group">
                <span>Bluetooth</span>
                @if (_bluetoothConnected)
                {
                    <span>@(_bluetoothDeviceName ?? "Remote connected")</span>
                    <button @onclick="DisconnectBluetoothAsync">Disconnect</button>
                }
                else
                {
                    <button @onclick="ConnectBluetoothAsync">Pair remote</button>
                }
            </div>
            <div class="control-group">
                <a href="/players">Manage Players</a>
                <a href="/matches">Match History</a>
            </div>
            <div class="control-group">
                <button @onclick="EndGame">End Game</button>
                <button @onclick="NewGame">New Game</button>
            </div>
            <p class="hint">@L.T("ControlsHint")</p>
        </div>
    }

    @if (_showPlayerPicker is { } slot)
    {
        <div class="player-picker-overlay" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            <div class="player-picker-dialog">
                <h3>@L.T(slot == 1 ? "Player1Label" : "Player2Label")</h3>
                @if (_rosterPlayers.Count == 0)
                {
                    <p class="picker-empty">No players in the roster yet - add some on the Players page.</p>
                }
                else
                {
                    <div class="picker-list">
                        @foreach (var p in _rosterPlayers)
                        {
                            <button class="picker-row" @onclick="() => SelectRosterPlayer(slot, p.Id)">
                                @if (!string.IsNullOrEmpty(p.PhotoPath))
                                {
                                    <img src="@p.PhotoPath" alt="" />
                                }
                                else
                                {
                                    <div class="picker-photo-placeholder">?</div>
                                }
                                <span>@(string.IsNullOrWhiteSpace(p.Nickname) ? p.Name : p.Nickname)</span>
                            </button>
                        }
                    </div>
                }
                <button class="picker-clear" @onclick="() => ClearRosterPlayer(slot)">Use manual name instead</button>
                <button class="picker-close" @onclick="ClosePlayerPicker">Close</button>
            </div>
        </div>
    }
</div>

@code {
    private bool IsOnline = false;
    private bool _showControls;
    private IJSObjectReference? _kiosk;
    private IJSObjectReference? _bluetooth;
    private DotNetObjectReference<Home>? _selfRef;
    private bool _bluetoothConnected;
    private string? _bluetoothDeviceName;
    private ElementReference board;
    private readonly CancellationTokenSource _shotClockCts = new();

    private Player? _resolvedPlayer1;
    private Player? _resolvedPlayer2;
    private List<Player> _rosterPlayers = new();
    private int? _showPlayerPicker;

    private ScoreboardState Current =new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await board.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        L.SetLanguage(GetQueryParam(Nav.Uri, "lang"));
        L.LanguageChanged += Adjust;
        Hub.CommandReceived += OnRemoteCommand;
        Hub.ConnectionChanged += OnHubConnectionChanged;
        IsOnline = Hub.HasActiveConnection;
        _ = RunShotClockAsync(_shotClockCts.Token);
        var game = await DbContext.ScoreboardStates.Where(p => p.Id == 1).FirstOrDefaultAsync();
        if (game is null)
        {
            var saved = new ScoreboardState
            {
                Inning = 0,
                CurrentPoints = 0,
                Player1Score = 0,   
                Player2Score = 0,
                Player1Avg = 0,
                Player2Avg = 0,
                Player1HighRun = 0,
                Player2HighRun = 0,
                ActivePlayer = 1,
                MatchTarget = 20,
                Player1Name = "Player 1",
                Player2Name = "Player 2",
                ShotClockActive  =false,
                ShotClockRemaining = 40,
                ShotClockSeconds = 40
            };
            DbContext.ScoreboardStates.Add(saved);
            await DbContext.SaveChangesAsync();
            Current= saved;
        }
        else Current = game;
        ResolvePlayers();
        StateHasChanged();

    }

    private void ResolvePlayers()
    {
        _resolvedPlayer1 = Current.Player1Id is int id1 ? DbContext.Players.FirstOrDefault(p => p.Id == id1) : null;
        _resolvedPlayer2 = Current.Player2Id is int id2 ? DbContext.Players.FirstOrDefault(p => p.Id == id2) : null;
    }

    private string GetDisplayName(int slot)
    {
        var resolved = slot == 1 ? _resolvedPlayer1 : _resolvedPlayer2;
        if (resolved is not null)
        {
            return string.IsNullOrWhiteSpace(resolved.Nickname) ? resolved.Name : resolved.Nickname;
        }

        var manual = slot == 1 ? Current.Player1Name : Current.Player2Name;
        return string.IsNullOrWhiteSpace(manual) ? L.T(slot == 1 ? "Player1Default" : "Player2Default") : manual;
    }

    private string? GetPhotoPath(int slot) => (slot == 1 ? _resolvedPlayer1 : _resolvedPlayer2)?.PhotoPath;

    private async Task OpenPlayerPickerAsync(int slot)
    {
        _rosterPlayers = await DbContext.Players.OrderBy(p => p.Id).ToListAsync();
        _showPlayerPicker = slot;
        StateHasChanged();
    }

    private void ClosePlayerPicker()
    {
        _showPlayerPicker = null;
    }

    private void SelectRosterPlayer(int slot, int playerId)
    {
        if (slot == 1) Current.Player1Id = playerId; else Current.Player2Id = playerId;
        ResolvePlayers();
        _showPlayerPicker = null;
        Persist();
    }

    private void ClearRosterPlayer(int slot)
    {
        if (slot == 1) Current.Player1Id = null; else Current.Player2Id = null;
        ResolvePlayers();
        _showPlayerPicker = null;
        Persist();
    }
    private void Adjust(Action<ScoreboardState> action)
    {
        action(Current);
        Persist();
    }
    private void Adjust() => StateHasChanged();
    private void Persist()
    {
        DbContext.SaveChanges();
        StateHasChanged();
        _ = BroadcastStateAsync();
    }

    /// <summary>Pushes the current board state to every connected WS control client, so none of
    /// them are left showing a stale view after a change made here (keyboard, on-screen controls,
    /// another remote command, etc.). Fire-and-forget from Persist() - broadcasting is best-effort
    /// and must never block or fail the actual board update.</summary>
    private async Task BroadcastStateAsync()
    {
        try
        {
            var snapshot = ScoreboardStateSnapshotFactory.Create(Current, _resolvedPlayer1, _resolvedPlayer2);
            await Hub.BroadcastStateAsync(snapshot);
        }
        catch
        {
            // best-effort broadcast; a failed send to one client shouldn't affect the board itself
        }
    }
    private void SetPlayerName(int slot, string? name)
    {
        if (int.TryParse(name, out var maybePlayerId))
        {
            var player = DbContext.Players.FirstOrDefault(p => p.Id == maybePlayerId);
            if (player is not null)
            {
                SelectRosterPlayer(slot, player.Id);
                return;
            }
        }

        if (slot == 1)
        {
            Current.Player1Name = name ?? "";
        }
        else
        {
            Current.Player2Name = name ?? "";
        }
        Persist();
    }

    private void SetMatchTarget(string? value)
    {
        if (int.TryParse(value, out var target))
        {
            SetMatchTarget(target);
        }
    }

    private void SetMatchTarget(int target)
    {
        Current.MatchTarget = Math.Max(1, target);
        Persist();
    }

    private void StopShotClock()
    {
        Current?.ShotClockActive = false;
        Persist();
    }
    private void StartShotClock()
    {
        Current?.ShotClockActive = true;
        Persist();
    }
    private void ResetShotClock()
    {
        Current?.ShotClockRemaining = Current.ShotClockSeconds;
        Current?.ShotClockActive = false;
        Persist();
    }

    private void OnLanguageChanged(ChangeEventArgs e) => L.SetLanguage(e.Value?.ToString());

    private static string? GetQueryParam(string uri, string name)
    {
        var query = new Uri(uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && Uri.UnescapeDataString(parts[0]) == name)
            {
                return Uri.UnescapeDataString(parts[1]);
            }
        }

        return null;
    }


    private double ShotClockPercent => Current?.ShotClockSeconds > 0
        ? Math.Clamp(Current.ShotClockRemaining / Current.ShotClockSeconds * 100, 0, 100)
        : 0;

    private int ShotClockDisplaySeconds => (int)Math.Ceiling(Current?.ShotClockRemaining ?? 0);

    private void CommitCurrentPoints() 
    {
        if (Current is null) return;
        var points = Current.CurrentPoints;

        if (Current.ActivePlayer == 2)
        {
            Current.Player2Score += points;
            Current.Player2HighRun = Math.Max(Current.Player2HighRun, points);
            Current.ActivePlayer = 1;
            Current.Inning++; // both players have now taken their shot this round
        }
        else
        {
            Current.Player1Score += points;
            Current.Player1HighRun = Math.Max(Current.Player1HighRun, points);
            Current.ActivePlayer = 2;
        }

        Current.Player1Avg = Current.Inning > 0 ? (double)Current.Player1Score / Current.Inning : 0;
        Current.Player2Avg = Current.Inning > 0 ? (double)Current.Player2Score / Current.Inning : 0;

        Current.CurrentPoints = 0;
        Persist();
    }

    /// <summary>Saves the current match to history. Does not reset the board - the final score
    /// stays on screen (e.g. for a photo/announcement) until "New Game" is pressed.</summary>
    private void EndGame()
    {
        var winner = Current.Player1Score > Current.Player2Score ? 1
            : Current.Player2Score > Current.Player1Score ? 2
            : 0;

        DbContext.MatchResults.Add(new MatchResult
        {
            PlayedAt = DateTime.Now,
            Player1Id = Current.Player1Id,
            Player1Name = GetDisplayName(1),
            Player1Score = Current.Player1Score,
            Player1Avg = Current.Player1Avg,
            Player1HighRun = Current.Player1HighRun,
            Player2Id = Current.Player2Id,
            Player2Name = GetDisplayName(2),
            Player2Score = Current.Player2Score,
            Player2Avg = Current.Player2Avg,
            Player2HighRun = Current.Player2HighRun,
            Inning = Current.Inning,
            MatchTarget = Current.MatchTarget,
            Winner = winner
        });

        Current.ShotClockActive = false;
        Persist();
    }

    /// <summary>Resets the board for a new match. Does not save anything - press "End Game" first
    /// if the current match's stats should be kept.</summary>
    private void NewGame()
    {
        Current.Player1Score = 0;
        Current.Player2Score = 0;
        Current.Player1Avg = 0;
        Current.Player2Avg = 0;
        Current.Player1HighRun = 0;
        Current.Player2HighRun = 0;
        Current.Inning = 0;
        Current.CurrentPoints = 0;
        Current.ActivePlayer = 1;
        Current.Player1Id = null;
        Current.Player2Id = null;
        Current.Player1Name = "";
        Current.Player2Name = "";
        Current.ShotClockActive = false;
        Current.ShotClockRemaining = Current.ShotClockSeconds;

        ResolvePlayers();
        Persist();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "p" or "P")
        {
            await OpenPlayerPickerAsync(Current.ActivePlayer);
            return;
        }

        ScoreboardCommand? command = e.Key switch
        {
            "c" or "C" => ScoreboardCommand.ToggleControls,
            "t" or "T" => ScoreboardCommand.ToggleShotClock,
            "r" or "R" => ScoreboardCommand.ResetShotClock,
            "1" => ScoreboardCommand.SelectPlayer1,
            "2" => ScoreboardCommand.SelectPlayer2,
            "+" or "=" => ScoreboardCommand.IncrementPoints,
            "-" or "_" => ScoreboardCommand.DecrementPoints,
            "Enter" => ScoreboardCommand.CommitPoints,
            _ => null
        };

        if (command is not null)
        {
            ApplyCommand(command.Value);
        }
    }

    /// <summary>Single entry point for keyboard, WebSocket control-app, and Bluetooth remote input.</summary>
    private void ApplyCommand(ScoreboardCommand command, JsonElement? payload = null)
    {
        switch (command)
        {
            case ScoreboardCommand.ToggleControls:
                _showControls = !_showControls;
                StateHasChanged();
                break;
            case ScoreboardCommand.ToggleShotClock:
                if (Current.ShotClockActive) StopShotClock(); else StartShotClock();
                break;
            case ScoreboardCommand.ResetShotClock:
                ResetShotClock();
                break;
            case ScoreboardCommand.SelectPlayer1:
                ChangeActivePlayer(1);
                break;
            case ScoreboardCommand.SelectPlayer2:
                ChangeActivePlayer(2);
                break;
            case ScoreboardCommand.IncrementPoints:
                Adjust(s => s.CurrentPoints++);
                break;
            case ScoreboardCommand.DecrementPoints:
                Adjust(s => s.CurrentPoints--);
                break;
            case ScoreboardCommand.CommitPoints:
                CommitCurrentPoints();
                break;

            case ScoreboardCommand.RenamePlayer1:
                SetPlayerName(1, GetStringPayload(payload));
                break;
            case ScoreboardCommand.RenamePlayer2:
                SetPlayerName(2, GetStringPayload(payload));
                break;
            case ScoreboardCommand.UpsertPlayer:
                UpsertPlayerFromPayload(payload);
                break;
            case ScoreboardCommand.EndGame:
                EndGame();
                break;
            case ScoreboardCommand.NewGame:
                NewGame();
                break;
            case ScoreboardCommand.SetMatchTarget:
                if (GetIntPayload(payload) is int matchTarget)
                {
                    SetMatchTarget(matchTarget);
                }
                break;
            case ScoreboardCommand.IncrementPlayer1Score:
                Adjust(s => s.Player1Score++);
                break;
            case ScoreboardCommand.DecrementPlayer1Score:
                Adjust(s => s.Player1Score--);
                break;
            case ScoreboardCommand.IncrementPlayer2Score:
                Adjust(s => s.Player2Score++);
                break;
            case ScoreboardCommand.DecrementPlayer2Score:
                Adjust(s => s.Player2Score--);
                break;
            case ScoreboardCommand.IncrementInning:
                Adjust(s => s.Inning++);
                break;
            case ScoreboardCommand.DecrementInning:
                Adjust(s => s.Inning--);
                break;
            case ScoreboardCommand.SelectRosterPlayer1:
                if (GetIntPayload(payload) is int rosterPlayer1Id)
                {
                    SelectRosterPlayer(1, rosterPlayer1Id);
                }
                break;
            case ScoreboardCommand.SelectRosterPlayer2:
                if (GetIntPayload(payload) is int rosterPlayer2Id)
                {
                    SelectRosterPlayer(2, rosterPlayer2Id);
                }
                break;
            case ScoreboardCommand.ClearRosterPlayer1:
                ClearRosterPlayer(1);
                break;
            case ScoreboardCommand.ClearRosterPlayer2:
                ClearRosterPlayer(2);
                break;
        }
    }

    private static string? GetStringPayload(JsonElement? payload) =>
        payload?.ValueKind == JsonValueKind.String ? payload.Value.GetString() : null;

    private static int? GetIntPayload(JsonElement? payload) =>
        payload?.ValueKind == JsonValueKind.Number && payload.Value.TryGetInt32(out var value) ? value : null;

    private void UpsertPlayerFromPayload(JsonElement? payload)
    {
        if (payload is not { ValueKind: JsonValueKind.Object } element)
        {
            return;
        }

        PlayerUpsertPayload? data;
        try
        {
            data = element.Deserialize<PlayerUpsertPayload>(new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (JsonException)
        {
            return;
        }

        if (data is null)
        {
            return;
        }

        string? photoPath = null;
        if (!string.IsNullOrEmpty(data.PhotoBase64))
        {
            byte[] bytes;
            try
            {
                bytes = Convert.FromBase64String(data.PhotoBase64);
            }
            catch (FormatException)
            {
                return;
            }

            var extension = string.IsNullOrWhiteSpace(data.PhotoExtension) ? "jpg" : data.PhotoExtension.TrimStart('.');
            var playersFolder = Path.Combine(Env.WebRootPath, "Players");
            Directory.CreateDirectory(playersFolder);
            var fileName = $"{data.Id}.{extension}";
            File.WriteAllBytes(Path.Combine(playersFolder, fileName), bytes);
            photoPath = $"Players/{fileName}";
        }

        var existing = DbContext.Players.FirstOrDefault(p => p.Id == data.Id);
        if (existing is null)
        {
            DbContext.Players.Add(new Player
            {
                Id = data.Id,
                Nickname = data.Nickname ?? "",
                Name = data.Name ?? "",
                PhotoPath = photoPath
            });
        }
        else
        {
            if (data.Nickname is not null) existing.Nickname = data.Nickname;
            if (data.Name is not null) existing.Name = data.Name;
            if (photoPath is not null) existing.PhotoPath = photoPath;
        }

        DbContext.SaveChanges();
        ResolvePlayers();
        StateHasChanged();
        _ = BroadcastStateAsync();
    }

    private void OnRemoteCommand(ScoreboardCommand command, JsonElement? payload)
    {
        InvokeAsync(() => ApplyCommand(command, payload));
    }

    private void OnHubConnectionChanged()
    {
        InvokeAsync(() =>
        {
            IsOnline = Hub.HasActiveConnection;
            StateHasChanged();
        });
    }

    private void ChangeActivePlayer(int player)
    {
        Current.ActivePlayer = player;
        Persist();
    }

    private async Task RequestFullscreenAsync()
    {
        _kiosk ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/kiosk.js");
        await _kiosk.InvokeVoidAsync("requestFullscreen");
        await board.FocusAsync();
    }

    private async Task ConnectBluetoothAsync()
    {
        _bluetooth ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bluetooth.js");
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await _bluetooth.InvokeVoidAsync("connect", _selfRef);
        }
        catch (JSException)
        {
            // user cancelled the device chooser, or the browser/device doesn't support it - nothing to do
        }
    }

    private async Task DisconnectBluetoothAsync()
    {
        if (_bluetooth is not null)
        {
            await _bluetooth.InvokeVoidAsync("disconnect");
        }
    }

    [JSInvokable]
    public void OnBluetoothCommand(string raw)
    {
        var message = ScoreboardCommandParser.TryParse(raw);
        if (message is not null)
        {
            InvokeAsync(() => ApplyCommand(message.Command, message.Payload));
        }
    }

    [JSInvokable]
    public void OnBluetoothConnected(string deviceName)
    {
        InvokeAsync(() =>
        {
            _bluetoothConnected = true;
            _bluetoothDeviceName = deviceName;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnBluetoothDisconnected()
    {
        InvokeAsync(() =>
        {
            _bluetoothConnected = false;
            StateHasChanged();
        });
    }

    private async Task RunShotClockAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
            while (await timer.WaitForNextTickAsync(token))
            {
                if (!Current.ShotClockActive) continue;

                Current.ShotClockRemaining = Math.Max(0, Current.ShotClockRemaining - 0.1);
                if (Current.ShotClockRemaining <= 0)
                {
                    Current.ShotClockActive = false;
                    DbContext.SaveChanges();
                    await BroadcastStateAsync();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        L.LanguageChanged -= Adjust;
        Hub.CommandReceived -= OnRemoteCommand;
        Hub.ConnectionChanged -= OnHubConnectionChanged;
        if (_shotClockCts is not null)
        {
            _shotClockCts.Cancel();
            _shotClockCts.Dispose();
        }
        try
        {
            if (_kiosk is not null)
            {
                await _kiosk.DisposeAsync();
            }
            if (_bluetooth is not null)
            {
                await _bluetooth.InvokeVoidAsync("disconnect");
                await _bluetooth.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // circuit is already gone (tab closed, refresh, connection drop) - the browser
            // side is being torn down anyway, so there's nothing left to clean up via JS interop
        }
        _selfRef?.Dispose();
    }
}
