@page "/matches"
@inject DataContext DbContext
@using Zeymera.Scoreboard.Client.Models
@using Zeymera.Scoreboard.Client.Services
@using Microsoft.EntityFrameworkCore

<div class="matches-page">
    <p><a class="back-link" href="/">&larr; Back to board</a></p>
    <h1>Match History</h1>

    @if (_matches.Count == 0)
    {
        <p class="empty-hint">No finished matches yet.</p>
    }
    else
    {
        <table class="match-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Player 1</th>
                    <th>Score</th>
                    <th>Avg</th>
                    <th>High Run</th>
                    <th>Player 2</th>
                    <th>Score</th>
                    <th>Avg</th>
                    <th>High Run</th>
                    <th>Innings</th>
                    <th>Target</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _matches)
                {
                    <tr>
                        <td>@m.PlayedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="@(m.Winner == 1 ? "winner" : "")">@m.Player1Name</td>
                        <td>@m.Player1Score</td>
                        <td>@m.Player1Avg.ToString("0.000")</td>
                        <td>@m.Player1HighRun</td>
                        <td class="@(m.Winner == 2 ? "winner" : "")">@m.Player2Name</td>
                        <td>@m.Player2Score</td>
                        <td>@m.Player2Avg.ToString("0.000")</td>
                        <td>@m.Player2HighRun</td>
                        <td>@m.Inning</td>
                        <td>@m.MatchTarget</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<MatchResult> _matches = new();

    protected override async Task OnInitializedAsync()
    {
        _matches = await DbContext.MatchResults.OrderByDescending(m => m.PlayedAt).ToListAsync();
    }
}
