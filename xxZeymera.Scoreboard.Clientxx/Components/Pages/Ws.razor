@page "/ws"
@using Zeymera.Scoreboard.Client.Infrastructure
@inject WebSocketService WebSocket
@inject IConfiguration Configuration
@inject NavigationManager Nav
<div class="monitor-value">
    @Value
</div>
@code {
    private string Value = "";
    protected override async Task OnInitializedAsync()
    {
        WebSocket.ValueReceived += OnValueReceived;

        var url = Configuration["MonitorSocketUrl"] ?? BuildSameOriginWsUrl();
        await WebSocket.ConnectAsync(url);
    }

    private string BuildSameOriginWsUrl()
    {
        var uri = new Uri(Nav.BaseUri);
        var scheme = uri.Scheme == "https" ? "wss" : "ws";
        return $"{scheme}://{uri.Authority}/ws";
    }

    private async void OnValueReceived(string value)
    {
        Value = value;
       await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WebSocket.ValueReceived -= OnValueReceived;
    }
}